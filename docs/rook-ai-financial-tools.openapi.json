{
  "openapi": "3.1.0",
  "info": {
    "title": "Rook AI — ferramentas financeiras",
    "version": "1.0.0",
    "description": "Contrato local para integração com uma IA conversacional. Este arquivo não comprova publicação nem conexão ao AsaFlow. A IA conduz a conversa; as rotas validam o cenário e calculam. Campos confirmed não provam, sozinhos, uma confirmação real: a plataforma de conversa deve vinculá-los à mensagem do visitante. A qualificação e o cadastro de lead são fluxos separados."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origem do ambiente em que estas rotas estiverem publicadas; o arquivo não comprova publicação."
    }
  ],
  "paths": {
    "/api/ai/tools/analisar-cmv/": {
      "post": {
        "operationId": "analisar_cmv",
        "summary": "Compara o CMV já apurado com a referência indicativa do segmento. Não calcula consumo de estoque e não cadastra contato.",
        "description": "Cálculo puro, sem CRM, armazenamento, dados privados ou chamada a LLM. Máximo de 4.096 bytes em JSON UTF-8. Retorne o JSON da resposta ao contexto da mesma conversa de IA. Dados podem vir em qualquer ordem. Nunca complete campos financeiros desconhecidos com zero. Confirme o cenário antes de confirmed=true; toda correção invalida a confirmação anterior.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/analisar_cmv_request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "success: apresentar o resultado e as premissas; needs_information: perguntar apenas o que falta; needs_confirmation: mostrar cenário para confirmação. Não há cálculo nos dois últimos estados.",
            "headers": {
              "Cache-Control": {
                "description": "O cenário e o resultado não podem ser armazenados em cache.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/analisar_cmv_success"
                    },
                    {
                      "$ref": "#/components/schemas/analisar_cmv_needs_information"
                    },
                    {
                      "$ref": "#/components/schemas/analisar_cmv_needs_confirmation"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Corpo vazio, JSON inválido, UTF-8 inválido ou falha de leitura. A mensagem não reflete o corpo.",
            "headers": {
              "Cache-Control": {
                "description": "O cenário e o resultado não podem ser armazenados em cache.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invalid_input"
                }
              }
            }
          },
          "413": {
            "description": "O corpo excede 4.096 bytes. O limite é aplicado durante a leitura, inclusive sem Content-Length.",
            "headers": {
              "Cache-Control": {
                "description": "O cenário e o resultado não podem ser armazenados em cache.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invalid_input"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type diferente de application/json. Parâmetros como charset=utf-8 são aceitos.",
            "headers": {
              "Cache-Control": {
                "description": "O cenário e o resultado não podem ser armazenados em cache.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invalid_input"
                }
              }
            }
          },
          "422": {
            "description": "Campo inválido ou extra, base incompatível ou cenário que não atende ao contrato. Não usar resultado anterior.",
            "headers": {
              "Cache-Control": {
                "description": "O cenário e o resultado não podem ser armazenados em cache.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invalid_input"
                }
              }
            }
          }
        }
      }
    },
