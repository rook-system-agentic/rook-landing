# Newsletter (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://rooksystem.com.br

# Blog CMS (Supabase REST, optional; local editorial seed is used as fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional: dedicated HMAC secret for the commercial-lead antiabuse challenge.
# When omitted, the server reuses SUPABASE_SERVICE_ROLE_KEY as the HMAC secret.
# COMMERCIAL_LEAD_ABUSE_SECRET=replace-with-at-least-32-random-characters
# Or public read via RLS:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
