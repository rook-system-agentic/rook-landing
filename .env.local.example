# Newsletter (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://rooksystem.com.br

# Blog CMS (Supabase REST, optional; local editorial seed is used as fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional: dedicated HMAC secret for the commercial-lead antiabuse challenge.
# When omitted, the server reuses SUPABASE_SERVICE_ROLE_KEY as the HMAC secret.
# COMMERCIAL_LEAD_ABUSE_SECRET=replace-with-at-least-32-random-characters
# Or public read via RLS:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Captação consultiva — somente no servidor, desligada por padrão.
# Chave dedicada: contacts:write + deals:write (write já inclui leitura do recurso).
# Confirmar ambiente, workspace, funil e etapa inicial aberta antes de habilitar.
ASAFLOW_ACQUISITION_ENABLED=false
ASAFLOW_ACQUISITION_API_KEY=
ASAFLOW_ACQUISITION_PIPELINE_ID=
ASAFLOW_ACQUISITION_STAGE_ID=
# Prévia local sem envio: NEXT_PUBLIC_ENV=homolog + /?preview=1

# Chat global: slugs públicos do link externo do fluxo (NÃO são API keys).
# O site monta o SDK standalone uma vez, apenas ao abrir a conversa.
# Habilitar somente com o fluxo validado, publicado e com link externo ativo.
# NEXT_PUBLIC_ENV=homolog impede qualquer montagem do canal real.
NEXT_PUBLIC_ASAFLOW_CHAT_ENABLED=false
NEXT_PUBLIC_ASAFLOW_CHAT_TENANT=
NEXT_PUBLIC_ASAFLOW_CHAT_FLOW=
