# Newsletter (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Analytics (GA4)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Meta (Facebook) Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Site canonical URL
NEXT_PUBLIC_SITE_URL=https://rooksystem.com.br

# Blog CMS (Supabase REST, optional; local editorial seed is used as fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional: dedicated HMAC secret for the commercial-lead antiabuse challenge.
# When omitted, the server reuses SUPABASE_SERVICE_ROLE_KEY as the HMAC secret.
# COMMERCIAL_LEAD_ABUSE_SECRET=replace-with-at-least-32-random-characters
# Or public read via RLS:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Experimento de /planos — contratação direta × atendimento assistido (ROO-1207)
# Porcentagem de visitantes que caem na Variante B (0 a 100). Sem valor = B desligada.
# Lida no servidor a cada requisição (middleware); mudar exige redeploy na Vercel.
LP_ASAFLOW_ASSISTED_PCT=0
# Snippet do canal "Chat - Cadastro Site" e URL de embed do formulário
# "Contato comercial · site" no AsaFlow. Sem os dois, a Variante B fica desligada
# independentemente da porcentagem. São públicos: vão para o bundle e o HTML.
# NEXT_PUBLIC_ASAFLOW_WIDGET_SRC=https://.../widget.js
# NEXT_PUBLIC_ASAFLOW_FORM_URL=https://.../f/b2faafd9-a851-44cd-b2dc-3cec2a95c3eb

# Captação consultiva — somente no servidor, desligada por padrão.
# Chave dedicada: contacts:write + deals:write (write já inclui leitura do recurso).
# Confirmar ambiente, workspace, funil e etapa inicial aberta antes de habilitar.
ASAFLOW_ACQUISITION_ENABLED=false
ASAFLOW_ACQUISITION_API_KEY=
ASAFLOW_ACQUISITION_PIPELINE_ID=
ASAFLOW_ACQUISITION_STAGE_ID=
# Prévia local sem envio: NEXT_PUBLIC_ENV=homolog + /?preview=1

# Chat global: slugs públicos do link externo do fluxo (NÃO são API keys).
# O site monta o SDK standalone uma vez, apenas ao abrir a conversa.
# Habilitar somente com o fluxo validado, publicado e com link externo ativo.
# NEXT_PUBLIC_ENV=homolog impede qualquer montagem do canal real.
NEXT_PUBLIC_ASAFLOW_CHAT_ENABLED=false
NEXT_PUBLIC_ASAFLOW_CHAT_TENANT=
NEXT_PUBLIC_ASAFLOW_CHAT_FLOW=

# ROO-1642 — Guia CMV: cadastro educativo e email transacional.
# Não reutiliza o banco do blog, newsletter ou captura financeira por fallback.
# Configurar cada ambiente e validar HML antes de habilitar produção.
CMV_GUIDE_ENABLED=false
CMV_GUIDE_DELIVERY_ENABLED=false
CMV_GUIDE_ENV=homolog
CMV_GUIDE_SUPABASE_URL=
CMV_GUIDE_SUPABASE_SERVICE_ROLE_KEY=
CMV_GUIDE_ABUSE_SECRET=
CMV_GUIDE_DISPATCH_SECRET=
CMV_GUIDE_FROM=
# Opcional: canal real e monitorado para respostas, sem fallback presumido.
CMV_GUIDE_REPLY_TO=
# Obrigatório em homologação; somente esse destinatário pode receber o teste.
CMV_GUIDE_TEST_EMAIL=
# RESEND_API_KEY é lida somente no servidor; nunca NEXT_PUBLIC_*.
# Bucket privado fixo: cmv-guide-private. Arquivos/checksums no módulo CMV.
# GitHub Actions (vars): CMV_GUIDE_HML_DISPATCH_ENABLED=false,
# CMV_GUIDE_PROD_DISPATCH_ENABLED=false. (Secrets) chaves por ambiente separadas:
# CMV_GUIDE_HML_DISPATCH_SECRET e CMV_GUIDE_PROD_DISPATCH_SECRET.
