#!/usr/bin/env bash
# Entry point privilegiado e deliberadamente estreito para o runner da landing.
# A cópia em /usr/local/bin é root-owned; ela nunca executa código do checkout.
set -euo pipefail

GENERATOR=/usr/local/lib/rook-lp/generate-secret.sh
RUNTIME_ENV=/etc/rook-production/runtime/landing.production.env

if [ "$#" -ne 2 ]; then
  printf 'Uso: %s <source-revision> <generator-sha256>\n' "$0" >&2
  exit 64
fi
SOURCE_REVISION=$1
EXPECTED_GENERATOR_SHA=$2

[[ "$SOURCE_REVISION" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'ERRO: revisão inválida.\n' >&2
  exit 64
}
[[ "$EXPECTED_GENERATOR_SHA" =~ ^[0-9a-f]{64}$ ]] || {
  printf 'ERRO: checksum inválido.\n' >&2
  exit 64
}

test -x "$GENERATOR" || {
  printf 'ERRO: gerador privilegiado ausente.\n' >&2
  exit 1
}
ACTUAL_GENERATOR_SHA=$(sha256sum "$GENERATOR" | awk '{print $1}')
[ "$ACTUAL_GENERATOR_SHA" = "$EXPECTED_GENERATOR_SHA" ] || {
  printf 'ERRO: gerador do host diverge do commit; instalação root necessária.\n' >&2
  exit 1
}

# Sem HOME no ambiente limpo, o cache padrão do kubectl seria relativo ao
# checkout. O caminho absoluto evita deixar arquivos root-owned no runner.
exec env -i \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  KUBECONFIG=/etc/rancher/k3s/k3s.yaml \
  KUBECACHEDIR=/var/cache/rook-lp/kubectl \
  NS=rook-production \
  SB_NS=supabase-production \
  SECRET=rook-lp-production-env \
  RUNTIME_ENV="$RUNTIME_ENV" \
  SOURCE_REVISION="$SOURCE_REVISION" \
  "$GENERATOR"
